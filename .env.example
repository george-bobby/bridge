# Bridge config. Copy to .env, or leave it empty and connect things in the app
# (Settings › Integrations). A real environment variable overrides any value here.
#
# Most of what used to be typed in here, Bridge now works out itself
# (server/identity.js): your GitHub login from gh, your Slack and Linear
# identity from their tokens, the pipeline repo's GitHub name from its git
# remote, and your PATH from your login shell. Set a key below only to override.

# Connections
SLACK_USER_TOKEN=                     # user token (xoxp-) for Slack; see docs/slack.md
LINEAR_API_KEY=                       # Linear > Settings > API > Personal API keys
VERCEL_TOKEN=                         # vercel.com/account/settings/tokens
INCIDENT_API_KEY=                     # incident.io > Settings > API keys (read access to incidents)
GRANOLA_API_KEY=                      # Granola app > Settings > Connectors > API keys

# Identity overrides
GITHUB_LOGIN=                         # default: gh's login
BRANCH_PREFIX=                        # branch names <prefix>/<slug>; default: your GitHub login
SLACK_USER_NAME=                      # default: your name on Slack
LINEAR_WORKSPACE=                     # default: your Linear organization
LINEAR_TEAM=                          # default: the team picked in Settings, else your first
LINEAR_ISSUE_PREFIX=                  # default: that team's key
LINEAR_PROJECT=                       # file pipeline tickets into this Linear project
VERCEL_TEAM_ID=                       # one Vercel team only (default: you and every team)

# Slack pipeline overrides
TARGET_REPO=                          # default: the project picked in Settings › Integrations › Slack
GITHUB_REPO=                          # default: that repo's origin remote (owner/name)
TARGET_SCOPE=                         # a subdirectory the pipeline stays inside
WORKTREE_ROOT=                        # default: <repo>-worktrees
PRODUCT_NAME=                         # default: the project's name
PIPELINE_MODEL=                       # default: the model picked in Settings, else opus
SLACK_PRODUCT_TEAM=                   # ticket hints, as Name:MemberID,Name:MemberID
SLACK_ENGINEER_TEAM=                  # ticket hints, as Name:MemberID,Name:MemberID

# Folders and runtime
DEFAULT_DIR=                          # where Default sessions run; set it from the app instead
WORKER_SKILL=                         # default: the skill picked in Settings › Agents (fetch)
EXTRA_PATH=                           # default: your login shell's PATH
MCP_READ_PREFIXES=                    # extra read-only MCP tool prefixes, e.g. docs_,brain_
BRIDGE_PORT=4319
LAUNCHD_LABEL=local.bridge
