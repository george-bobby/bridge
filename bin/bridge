#!/usr/bin/env node
/**
 * bridge — the harness's tools for its agents: the orchestrator spawns and steers
 * workers with it, workers `bridge declare` their phase. You use the app; nothing
 * here is meant for a person. Every command is a call to the local dashboard,
 * which owns the state; this script holds none.
 *
 *   bridge spawn --repo <path> --title "<t>" (--brief "<text>" | --brief-file <f>) [--branch b] [--model m] [--no-start]
 *   bridge slack <slack thread url>
 *   bridge status [--since 3h] [--json]       decisions waiting, to-dos, every task; --since adds what happened
 *   bridge sessions [--project <id> | --all] [--json]   every chat (an orchestrator sees its own scope)
 *   bridge read <id>                          any chat: briefing, report, recent turns, transcript path
 *   bridge followup <id> "<message>"          queued if the worker is mid-turn
 *   bridge relaunch <id> [--note "<text>"]
 *   bridge declare waiting|resumed|phase "<text>"   (task from $BRIDGE_TASK_ID, or --task <id>)
 *   bridge plan set "<item>" "<item>" … | plan add "<item>" | plan start|done|skip <n> | plan clear
 *   bridge decide <decision-id> "<answer>"    | bridge dismiss <decision-id>
 *   bridge defer <decision-id> YYYY-MM-DD
 *   bridge triage <slack-item-id> actionable|skip "<reason>"   (start one with `bridge slack <permalink>`)
 *   bridge todo add <key> "<text>" [--url u] | bridge todo done <key>
 *   bridge cleanup <id> [--force]
 *
 * The dashboard's address comes from $BRIDGE_URL (set in every harness session),
 * else BRIDGE_PORT in .env, else 4319.
 */

const fs = require("fs");
const path = require("path");

const ROOT = path.join(__dirname, "..");

function baseUrl() {
  if (process.env.BRIDGE_URL) return process.env.BRIDGE_URL.replace(/\/+$/, "");
  let port = process.env.BRIDGE_PORT;
  if (!port) {
    try {
      const m = fs.readFileSync(path.join(ROOT, ".env"), "utf8").match(/^\s*BRIDGE_PORT\s*=\s*["']?(\d+)/m);
      if (m) port = m[1];
    } catch {}
  }
  return `http://127.0.0.1:${port || 4319}`;
}

/** Who's calling: work the orchestrator starts reports back to it. */
const BY = process.env.BRIDGE_ROLE === "orchestrator" ? "orchestrator" : "";

async function call(method, p, body) {
  let res;
  try {
    res = await fetch(baseUrl() + p, {
      method,
      headers: body ? { "Content-Type": "application/json" } : {},
      body: body ? JSON.stringify(body) : undefined,
    });
  } catch (e) {
    die(`the dashboard isn't reachable at ${baseUrl()} (${e.cause ? e.cause.code || e.message : e.message}). Start it: npm start`);
  }
  const out = await res.json().catch(() => ({}));
  if (!res.ok || out.ok === false) die(out.error || `HTTP ${res.status}`, res.status === 409 ? 3 : 1);
  return out;
}

function die(msg, code = 1) {
  process.stderr.write(`bridge: ${msg}\n`);
  process.exit(code);
}

/** --flag value / --flag=value / bare flags; positionals stay in order. */
function parse(argv) {
  const flags = {};
  const pos = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const eq = a.indexOf("=");
      if (eq > 0) flags[a.slice(2, eq)] = a.slice(eq + 1);
      else if (argv[i + 1] !== undefined && !argv[i + 1].startsWith("--")) flags[a.slice(2)] = argv[++i];
      else flags[a.slice(2)] = true;
    } else pos.push(a);
  }
  return { flags, pos };
}

const ago = (t) => {
  if (!t) return "";
  const s = Math.floor(Date.now() / 1000) - t;
  return s < 90 ? `${s}s` : s < 5400 ? `${Math.round(s / 60)}m` : s < 172800 ? `${Math.round(s / 3600)}h` : `${Math.round(s / 86400)}d`;
};

function printTask(t) {
  const state = t.live ? (t.awaiting ? "LIVE·asking" : `LIVE${t.idleSec != null ? ` idle ${t.idleSec}s` : ""}`) : "idle";
  console.log(`${t.id}  [${t.status || "?"}] ${state}  ${t.title}`);
  const extra = [t.phase && `phase: ${t.phase}`, t.declared && t.declared.state === "waiting" && `waiting: ${t.declared.text}`, t.pr && `pr: ${t.pr}`, t.queuedFollowups && `${t.queuedFollowups} queued follow-up(s)`]
    .filter(Boolean)
    .join(" · ");
  if (extra) console.log(`    ${extra}`);
  if (t.tldr) console.log(`    ${t.tldr.replace(/\s+/g, " ").slice(0, 200)}`);
  for (const n of t.notes || []) console.log(`    ! ${n}`);
}

function printDecisions(list) {
  if (!list.length) return console.log("No decisions waiting.");
  for (const d of list) {
    console.log(`${d.id}  (${d.kind}${d.state === "deferred" ? `, deferred to ${d.deferUntil}` : ""})  ${d.title || d.taskId}`);
    console.log(`    ${d.text.replace(/\n/g, "\n    ")}`);
  }
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  const { flags, pos } = parse(rest);

  switch (cmd) {
    case "spawn": {
      let brief = flags.brief;
      if (flags["brief-file"]) brief = fs.readFileSync(String(flags["brief-file"]), "utf8");
      if (!brief || brief === true) die("spawn needs --brief <text> or --brief-file <file>");
      const opts = {};
      if (flags.model) opts.model = flags.model;
      if (flags.mode) opts.permissionMode = flags.mode;
      const out = await call("POST", "/api/tasks", {
        repo: flags.repo,
        title: flags.title,
        brief,
        branch: flags.branch,
        opts,
        start: !flags["no-start"],
        by: BY,
      });
      console.log(`${out.taskId}  ${out.state}`);
      console.log(`  branch:   ${out.branch}`);
      console.log(`  worktree: ${out.worktree}`);
      console.log(`  brief:    ${out.brief}`);
      return;
    }
    case "slack": {
      if (!pos[0]) die("slack <thread url>");
      const out = await call("POST", "/api/runs", { url: pos[0], start: true, by: BY });
      console.log(`${out.runId}  ${out.started ? "started" : out.queued ? "queued" : out.created ? "created" : "already had a chat"}`);
      return;
    }
    case "status": {
      const since = flags.since && flags.since !== true ? String(flags.since) : "";
      const [tasks, out] = await Promise.all([call("GET", "/api/tasks"), call("GET", `/api/catchup?since=${encodeURIComponent(since || "0m")}`)]);
      if (flags.json) return console.log(JSON.stringify({ ...out, events: since ? out.events : undefined, harness: tasks.harness, working: tasks.working }, null, 2));
      console.log(`${tasks.working} working · mode ${out.mode}`);
      console.log("\n== Waiting on you ==");
      printDecisions(out.decisions);
      if (out.todos.length) {
        console.log("\n== To-dos ==");
        for (const t of out.todos) console.log(`${t.key}  ${t.text}${t.url ? `  ${t.url}` : ""}  (${ago(t.createdAt)})`);
      }
      if (out.slack && out.slack.length) {
        console.log("\n== Slack, not started ==");
        for (const i of out.slack) {
          console.log(`${i.id}  ${i.who} in ${i.channel || "Slack"} (${ago(Math.floor(Number(i.ts)))} ago${i.count > 1 ? `, ${i.count} messages` : ""})${i.verdict ? `  [${i.verdict}${i.reason ? `: ${i.reason}` : ""}]` : ""}`);
          console.log(`    ${String(i.text).replace(/\s+/g, " ").slice(0, 200)}${i.permalink ? `\n    ${i.permalink}` : ""}`);
        }
      }
      console.log("\n== Tasks ==");
      if (!out.tasks.length) console.log("No tasks.");
      for (const t of out.tasks) printTask(t);
      if (!since) return;
      console.log(`\n== Events since ${since} ago ==`);
      if (!out.events.length) console.log("Nothing happened.");
      for (const e of out.events) console.log(`${ago(e.at).padStart(4)} ago  ${e.name.padEnd(20)} ${e.taskId}  ${String(e.text || "").replace(/\s+/g, " ").slice(0, 140)}`);
      return;
    }
    case "sessions": {
      const q = new URLSearchParams();
      if (flags.project) q.set("project", String(flags.project));
      else if (!flags.all && process.env.BRIDGE_ROLE === "orchestrator" && process.env.BRIDGE_TASK_ID) q.set("orchestrator", process.env.BRIDGE_TASK_ID);
      const out = await call("GET", `/api/sessions${q.toString() ? `?${q}` : ""}`);
      if (flags.json) return console.log(JSON.stringify(out.sessions, null, 2));
      return console.log(out.markdown);
    }
    case "read": {
      if (!pos[0]) die("read <session id>");
      const out = await call("GET", `/api/runs/${encodeURIComponent(pos[0])}/reference`);
      let text = "";
      try {
        text = fs.readFileSync(out.path, "utf8");
      } catch {}
      console.log(text || `(no briefing written: ${out.path})`);
      console.log(`\n--- transcript (run JSON, \`messages\`): ${out.transcript}${out.worktree ? `\n--- worktree: ${out.worktree}` : ""}`);
      return;
    }
    case "followup": {
      if (!pos[0] || !pos[1]) die('followup <id> "<message>"');
      const out = await call("POST", `/api/runs/${encodeURIComponent(pos[0])}/followup`, { text: pos.slice(1).join(" "), queue: true });
      console.log(out.queued ? "queued: delivered when the worker's current turn ends" : "sent");
      return;
    }
    case "relaunch": {
      if (!pos[0]) die("relaunch <id>");
      await call("POST", `/api/tasks/${encodeURIComponent(pos[0])}/relaunch`, { note: flags.note || "" });
      console.log("relaunched");
      return;
    }
    case "declare": {
      const task = flags.task || process.env.BRIDGE_TASK_ID;
      if (!task) die("declare needs $BRIDGE_TASK_ID (set in harness sessions) or --task <id>");
      if (!pos[0]) die('declare waiting|resumed|phase "<text>"');
      await call("POST", `/api/tasks/${encodeURIComponent(task)}/declare`, { state: pos[0], text: pos.slice(1).join(" ") });
      console.log(`declared ${pos[0]}`);
      return;
    }
    case "plan": {
      const task = flags.task || process.env.BRIDGE_TASK_ID;
      if (!task) die("plan needs $BRIDGE_TASK_ID (set in harness sessions) or --task <id>");
      if (!pos[0]) die('plan set "<item>" "<item>" … | add "<item>" | start|done|skip <n> | clear');
      const out = await call("POST", `/api/tasks/${encodeURIComponent(task)}/plan`, { op: pos[0], args: pos.slice(1) });
      const mark = { completed: "x", in_progress: ">", cancelled: "-" };
      out.plan.forEach((x, i) => console.log(`${i + 1}. [${mark[x.status] || " "}] ${x.text}`));
      return;
    }
    case "decide":
    case "dismiss": {
      if (!pos[0]) die(`${cmd} <decision-id>${cmd === "decide" ? ' "<answer>"' : ""}`);
      const action = cmd === "dismiss" ? "dismiss" : "answer";
      if (cmd === "decide" && !pos[1]) die('decide <decision-id> "<answer>"');
      const out = await call("POST", `/api/decisions/${encodeURIComponent(pos[0])}`, { action, answer: pos.slice(1).join(" ") });
      console.log(`${out.decision.id} ${out.decision.state}${out.decision.deliveredAs ? ` (${out.decision.deliveredAs})` : ""}`);
      return;
    }
    case "defer": {
      if (!pos[0] || !/^\d{4}-\d{2}-\d{2}$/.test(pos[1] || "")) die("defer <decision-id> YYYY-MM-DD");
      await call("POST", `/api/decisions/${encodeURIComponent(pos[0])}`, { action: "defer", answer: pos[1] });
      console.log(`deferred to ${pos[1]}`);
      return;
    }
    case "triage": {
      if (!pos[0] || !["actionable", "skip"].includes(pos[1])) die('triage <slack-item-id> actionable|skip "<reason>"');
      const out = await call("POST", `/api/slack/watch/${encodeURIComponent(pos[0])}`, { action: "triage", verdict: pos[1], reason: pos.slice(2).join(" ") });
      console.log(`${out.item.id} ${out.item.verdict}`);
      return;
    }
    case "todo": {
      const [sub, ...args] = pos;
      if (sub === "add") {
        if (!args[0] || !args[1]) die('todo add <key> "<text>"');
        const out = await call("POST", "/api/todos", { key: args[0], text: args.slice(1).join(" "), url: flags.url || "" });
        if (out.duplicate) die(`already on the list: ${out.todo.key} (${out.todo.text})`, 3);
        console.log(`added ${out.todo.key}`);
        return;
      }
      if (sub === "done") {
        if (!args[0]) die("todo done <key>");
        await call("POST", "/api/todos/done", { key: args[0] });
        console.log(`done ${args[0]}`);
        return;
      }
      die('todo add <key> "<text>" | todo done <key>');
    }
    case "cleanup": {
      if (!pos[0]) die("cleanup <id> [--force]");
      const out = await call("POST", `/api/tasks/${encodeURIComponent(pos[0])}/cleanup`, { force: !!flags.force });
      console.log(`${out.removed ? "worktree removed" : out.note || "nothing to remove"}${out.branch ? `; branch ${out.branch} kept` : ""}${out.killed && out.killed.length ? `; stopped pids ${out.killed.join(", ")}` : ""}`);
      return;
    }
    default:
      process.stdout.write(fs.readFileSync(__filename, "utf8").split("*/")[0].replace(/^#!.*\n\/\*\*\n/, "").replace(/^ \* ?/gm, ""));
      if (cmd && cmd !== "help" && cmd !== "--help") process.exit(2);
  }
}

main().catch((e) => die(e.message));
