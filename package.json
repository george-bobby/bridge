{
  "name": "bridge",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Zero-dependency local command center for Claude Code: a native macOS app with a Kanban board of sessions, your GitHub PRs and Linear issues, and Slack threads run end to end by headless Claude workers in their own worktrees.",
  "keywords": [
    "claude-code",
    "orchestrator",
    "kanban",
    "slack",
    "linear",
    "github",
    "dashboard"
  ],
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "./scripts/install.sh start",
    "stop": "./scripts/install.sh stop",
    "dev": "./scripts/install.sh stop >/dev/null; node lib/render.js && node --watch-path=index.js --watch-path=lib index.js",
    "foreground": "node lib/render.js && node index.js",
    "render": "node lib/render.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "app": "./scripts/build-app.sh install",
    "demo": "node scripts/demo.js",
    "lint": "node scripts/lint.js"
  }
}
